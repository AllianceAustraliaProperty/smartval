# SMARTval Frontend Environment Configuration Template
# Copy this file to .env.local or .env for local development

# ==============================================================================
# Client-Side Public Configuration (Inlined into browser bundle via NEXT_PUBLIC_)
# ==============================================================================

# Backend API URL (Relative '/api' in production with Caddy proxy; 'http://localhost:5000' in local dev)
NEXT_PUBLIC_API_URL=/api

# Firebase Web Client SDK Configuration (Client safe)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Google Maps JavaScript API (Client safe)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ==============================================================================
# Server-Only Configuration (STRICTLY PRIVATE - NEVER EXPOSE TO CLIENT)
# Protected by `server-only` boundary guards
# ==============================================================================

# MongoDB Connection String (Server-side user management & audit logging)
MONGODB_URI=mongodb://localhost:27017/property-valuation

# Firebase Admin Service Account Credentials (Server-side token verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Microsoft 365 / OneDrive Integration (Server-side Graph API)
CLIENT_ID=your-microsoft-app-client-id
CLIENT_SECRET=your-microsoft-app-client-secret
TENANT_ID=your-microsoft-tenant-id
USER_EMAIL=valuer@aapvaluations.com.au

# Internal JWT Secret (Optional fallback)
JWT_SECRET=your-super-secure-random-secret-key-min-32-chars
