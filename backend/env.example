# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Secret Key (change this in production!)
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/flask_app

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Configuration
API_TITLE=Flask API
API_VERSION=v1
API_DESCRIPTION=A simple Flask API with blueprints

# Base URL for serving uploaded files (used in templates)
# Development: http://localhost:5000
# Production: https://yourdomain.com
BASE_URL=http://localhost:5000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=smartval-bucket

# Microsoft Graph email (used for "Send Invoice")
# Azure AD app registration (APPLICATION permissions, admin consented):
#   - Mail.Send      -> required to send the invoice email
#   - User.Read.All  -> required for the sender (From) picker on the settings page
# These can reuse the same app as the OneDrive integration.
MS_GRAPH_TENANT_ID=your-azure-tenant-id
MS_GRAPH_CLIENT_ID=your-azure-app-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-app-client-secret
# Default mailbox the invoice email is sent from (must exist in the tenant).
# Can be overridden per-template via the Settings > Email Templates page.
MS_GRAPH_SENDER_EMAIL=accounts@yourdomain.com