# Production Environment Configuration for Company Deployment
# Copy this to .env and configure with your company's values

# Google Maps API Keys
# Get these from Google Cloud Console - restrict by domain for security
GOOGLE_MAPS_API_KEY=your_company_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_company_google_maps_api_key_here

# Database Configuration
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://swarnavomukherjee03:swarnavo@cluster0.ev6cooh.mongodb.net/smartval?retryWrites=true&w=majority

# Security - Generate a strong secret key (32+ characters)
SECRET_KEY=your-company-super-secure-secret-key-change-this-immediately

# CORS Configuration - Your company domains only
CORS_ORIGINS=https://your-company-domain.com,https://www.your-company-domain.com,https://app.your-company-domain.com

# API Configuration
NEXT_PUBLIC_API_URL=https://aapvaluations.com/api

# Optional: Additional security settings
FLASK_ENV=production
FLASK_DEBUG=False
NODE_ENV=production

# Optional: Upload folder configuration
UPLOAD_FOLDER=/app/uploads

# Optional: Base URL for file serving
BASE_URL=https://aapvaluations.com/api

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=smartval-bucket